generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // URL direta para migrations (opcional, só precisa se usar Prisma Data Proxy)
}

model User {
  id                       String                    @id @default(uuid())
  name                     String?
  email                    String                    @unique
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  emailVerified            DateTime?
  image                    String?
  age                      Int?
  appUsage                 AppUsage?
  description              String?
  fullName                 String?
  gender                   Gender?
  profession               String?
  whatsapp                 String?
  averageSessionPrice      String?
  clientsPerWeek           String?
  educationOrSpecialty     String?
  yearsOfExperience        String?
  passwordHash             String?
  stripeCustomerId         String?                   @unique
  mensagem_enviada         String?
  status_verificacao       StatusVerificacao?
  mensagem_grupo_essencia  String?
  preferredLanguage        String?
  notificationsEnabled     Boolean                   @default(false)
  accounts                 Account[]
  chatSessions             ChatSession[]
  chatHandoffs             ChatHandoff[]
  sessions                 Session[]
  subscriptions            Subscription[]
  symptomFolders           SymptomFolder[]
  pushSubscriptions        PushSubscription[]
  reminders                Reminder[]
  mustResetPassword        Boolean                   @default(false) @map("must_reset_password")
  temporaryPasswordPlain   String?                   @map("temporary_password_plain") @db.VarChar(32)
  whatsappSentAt           DateTime?                 @map("whatsapp_sent_at")
  /// Instante em que o unico aviso de acesso desta pessoa foi criado.
  ///
  /// A regra e uma mensagem por pessoa, e nao uma por venda: quem compra o livro
  /// impresso e o digital na mesma tarde recebe um aviso, nao dois. Esta coluna e
  /// a trava, e a corrida entre dois webhooks simultaneos se resolve nela. Ficar
  /// em `User`, e nao em `access_deliveries`, e o que permite a garantia ser do
  /// banco: a tabela de avisos ja nasceu com varias linhas por pessoa, entao um
  /// indice unico la nem subiria. Reenvio do atendimento nao passa por aqui.
  accessMessageAt          DateTime?                 @map("access_message_at")
  cpf                      String?                   @db.VarChar(14)
  pdfDownloads             PdfDownload[]
  pdfDownloadTokens        PdfDownloadToken[]
  pdfDownloadJobs          PdfDownloadJob[]
  userProfile              UserProfile?
  discoveryEvents          DiscoveryEvent[]
  conversationEvents       ConversationEvent[]
  userFacts                UserFact[]
  emailSequenceEnrollments EmailSequenceEnrollment[]
  journeyEvents            JourneyEvent[]

  @@index([mensagem_enviada])
  @@index([status_verificacao])
  @@index([mensagem_grupo_essencia])
  @@index([preferredLanguage])
  @@index([createdAt])
}

model ChatSession {
  id                         String              @id @default(uuid())
  userId                     String
  startedAt                  DateTime            @default(now())
  endedAt                    DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  threadId                   String?             @unique
  chatKind                   ChatKind            @default(SEARCH) @map("chat_kind")
  agent                      String?             @db.VarChar(16)
  routingStatus              String?             @map("routing_status") @db.VarChar(32)
  routingDestination         String?             @map("routing_destination") @db.VarChar(32)
  routingIntentSummary       String?             @map("routing_intent_summary") @db.Text
  routingQuestionCount       Int                 @default(0) @map("routing_question_count")
  isFavorite                 Boolean             @default(false)
  messageCount               Int                 @default(0) @map("message_count")
  lastCheckpointMessageCount Int                 @default(0) @map("last_checkpoint_message_count")
  messages                   ChatMessage[]
  user                       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceHandoffs             ChatHandoff[]       @relation("ChatHandoffSource")
  conversationEvents         ConversationEvent[]

  // Índices compostos para otimizar queries de sessões
  @@index([userId, startedAt]) // Busca de sessões por usuário ordenadas por data
  @@index([userId, isFavorite]) // Busca de sessões favoritas
  @@index([userId, chatKind, createdAt])
}

model ChatHandoff {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  sourceSessionId String      @map("source_session_id")
  destination     String      @db.VarChar(32)
  contextSummary  String      @map("context_summary") @db.Text
  expiresAt       DateTime    @map("expires_at")
  consumedAt      DateTime?   @map("consumed_at")
  targetThreadId  String?     @map("target_thread_id") @db.VarChar(64)
  createdAt       DateTime    @default(now()) @map("created_at")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceSession   ChatSession @relation("ChatHandoffSource", fields: [sourceSessionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sourceSessionId])
  @@index([expiresAt, consumedAt])
  @@map("chat_handoffs")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Plan {
  id                      String                   @id @default(uuid())
  name                    String
  stripePriceId           String                   @unique
  monthlyLimit            Int?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  active                  Boolean                  @default(true)
  amount                  Int?
  currency                String?
  interval                PlanInterval?
  intervalCount           Int?
  stripeProductId         String?
  trialPeriodDays         Int?
  hotmartOfferKey         String?                  @unique
  hotmartId               Int?                     @unique
  subscriptions           Subscription[]
  pendingHotmartPurchases PendingHotmartPurchase[]
}

/// Compras Hotmart recebidas pelo webhook quando o usuário ainda não existia.
/// Ao confirmar cadastro com o mesmo email, a assinatura é criada a partir daqui.
model PendingHotmartPurchase {
  id                   String   @id @default(uuid())
  email                String
  transaction          String // ID da transação Hotmart
  stripeSubscriptionId String   @unique // hotmart_${transaction} (idempotência)
  planId               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  status               String   @default("pending") // pending | consumed
  createdAt            DateTime @default(now())
  plan                 Plan     @relation(fields: [planId], references: [id])

  @@index([email, status])
  @@index([stripeSubscriptionId])
  @@map("pending_hotmart_purchases")
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String
  planId               String
  stripeSubscriptionId String   @unique
  status               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  plan                 Plan     @relation(fields: [planId], references: [id])
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Índices compostos para otimizar queries frequentes
  @@index([status, currentPeriodEnd]) // Busca de assinaturas ativas
  @@index([userId, status]) // Busca de assinatura por usuário e status
}

model ChatMessage {
  id            String          @id @default(uuid())
  chatSessionId String
  role          ChatMessageRole
  content       String
  createdAt     DateTime        @default(now())
  chatSession   ChatSession     @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, createdAt])
}

model ChatAnswerCache {
  id             String    @id @default(uuid())
  normalizedKey  String    @unique @db.VarChar(512)
  content        String
  contentLength  Int
  sourceThreadId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?

  // Índice para limpeza eficiente de cache expirado
  @@index([expiresAt])
}

model LogExecucao {
  id                         String   @id @default(uuid())
  data_execucao              DateTime @default(now())
  total_clientes_processados Int      @default(0)
  total_compras_encontradas  Int      @default(0)
  total_mensagens_enviadas   Int      @default(0)
  status                     String   @default("iniciado")
  created_at                 DateTime @default(now())

  @@index([data_execucao])
  @@map("log_execucoes")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminEmail String
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([adminId])
  @@index([timestamp])
  @@index([action])
  @@index([resource])
  @@map("audit_logs")
}

model AdminRequest {
  id            String             @id @default(uuid())
  userId        String
  userEmail     String
  userName      String
  reason        String?
  status        AdminRequestStatus @default(PENDING)
  requestedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  reviewerEmail String?
  notes         String?

  @@index([status])
  @@index([requestedAt])
  @@index([userEmail])
  @@map("admin_requests")
}

model PopupConfig {
  id            String      @id @default(uuid())
  title         String
  content       String
  imageUrl      String?
  subscribeLink String
  status        PopupStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model SymptomFolder {
  id        String         @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  notes     String?
  symptoms  SavedSymptom[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SavedSymptom {
  id                 String          @id @default(uuid())
  folderId           String
  symptom            String
  threadId           String?
  symptomStartPeriod String? // Período aproximado (ex: "há 2 semanas", "desde janeiro")
  emotionalHistory   String? // Histórico emocional (texto livre)
  copingStrategy     CopingStrategy? // Como encarou a situação (opções pré-definidas)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  folder             SymptomFolder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([createdAt])
}

model n8n_chat_histories {
  id         Int    @id @default(autoincrement())
  session_id String @db.VarChar(255)
  message    Json
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String // Chave pública
  auth      String // Chave de autenticação
  userAgent String? // Navegador/dispositivo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endpoint])
  @@map("push_subscriptions")
}

model Reminder {
  id         String    @id @default(uuid())
  userId     String? // null = lembrete global (todos os usuários)
  title      String
  message    String
  time       String // Formato HH:mm (ex: "09:00")
  daysOfWeek String // JSON array com dias da semana [0-6] onde 0 = domingo
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSentAt DateTime? // Última vez que foi enviado
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
  @@index([time])
  // Índice composto para otimizar busca de lembretes ativos por horário
  @@index([active, time])
  @@map("reminders")
}

enum AppUsage {
  PERSONAL
  PROFESSIONAL
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum PlanInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum ChatKind {
  SEARCH
  SIMULADOR
  PROF
  SYMPTOM_SEARCH
}

enum StatusVerificacao {
  ENVIADA
  PROCESSADO
  ERRO
  PENDENTE
}

enum PopupStatus {
  ACTIVE
  INACTIVE
}

enum AdminRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CopingStrategy {
  ACCEPTED_AND_SOUGHT_HELP // Aceitei e busquei ajuda
  DENIED_INITIALLY // Neguei inicialmente
  IGNORED_SYMPTOM // Ignorei o sintoma
  SOUGHT_INFO_ALONE // Busquei informações sozinho
  SHARED_WITH_FAMILY_FRIENDS // Compartilhei com familiares/amigos
  OTHER // Outro
}

enum CatalogSection {
  BIBLIOTECA
  AUDIOTERAPIA
}

enum CatalogPermissionKey {
  LIVRO_DIGITAL
  PDF
  VIDEO
  AUDIOTERAPIA
}

enum PaymentProvider {
  HOTMART
  STONE
  FREE
}

enum CatalogModuleMediaKind {
  VIDEO
  PDF
  AUDIO
}

/// Produtos exibidos nas páginas Biblioteca e Audioterapia (gerenciados no admin).
model CatalogProduct {
  id                  String                     @id @default(uuid())
  section             CatalogSection
  title               String                     @db.VarChar(255)
  description         String?                    @db.Text
  tagLabel            String?                    @map("tag_label") @db.VarChar(80)
  coverImageUrl       String?                    @map("cover_image_url")
  purchaseUrl         String                     @map("purchase_url")
  permissionKey       CatalogPermissionKey       @map("permission_key")
  /// pt | en | es — null = visível em todos os idiomas (pt-BR e pt-PT usam pt)
  locale              String?                    @db.VarChar(10)
  pdfIndex            Int                        @default(0) @map("pdf_index")
  /// URL pública do áudio/PDF/capa no Cloudflare R2
  mediaFileName       String?                    @map("media_file_name") @db.VarChar(2048)
  /// Faixas: [{ id, title, mediaFileName, locale, sortOrder, kind? }]
  mediaItems          Json?                      @map("media_items")
  unlockedLabel       String?                    @map("unlocked_label") @db.VarChar(80)
  /// ID numérico do produto na Hotmart (webhook product.id)
  hotmartProductId    String?                    @unique @map("hotmart_product_id") @db.VarChar(120)
  /// Código/SKU do produto na Stone (Pagar.me)
  stoneProductId      String?                    @unique @map("stone_product_id") @db.VarChar(120)
  paymentProvider     PaymentProvider            @default(HOTMART) @map("payment_provider")
  freeAccess          Boolean                    @default(false) @map("free_access")
  sortOrder           Int                        @default(0) @map("sort_order")
  active              Boolean                    @default(true)
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  grantsAsSource      CatalogProductGrant[]      @relation("GrantSource")
  grantsAsTarget      CatalogProductGrant[]      @relation("GrantTarget")
  productEntitlements ProductEntitlement[]
  externalIds         CatalogProductExternalId[]
  courseModules       CatalogCourseModule[]

  @@index([section, active, sortOrder])
  @@map("catalog_products")
}

/// Módulo de um curso (ex.: Módulo 1, Módulo 2).
model CatalogCourseModule {
  id               String               @id @default(uuid())
  catalogProductId String               @map("catalog_product_id")
  title            String               @db.VarChar(255)
  description      String?              @db.Text
  coverImageUrl    String?              @map("cover_image_url") @db.VarChar(2048)
  sortOrder        Int                  @default(0) @map("sort_order")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  catalogProduct   CatalogProduct       @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  media            CatalogModuleMedia[]

  @@index([catalogProductId, sortOrder])
  @@map("catalog_course_modules")
}

/// Mídia de um módulo (vídeo, PDF ou áudio).
model CatalogModuleMedia {
  id            String                 @id @default(uuid())
  moduleId      String                 @map("module_id")
  kind          CatalogModuleMediaKind
  title         String                 @db.VarChar(255)
  mediaFileName String                 @map("media_file_name") @db.VarChar(2048)
  /// pt | en | es — null = todos os idiomas
  locale        String?                @db.VarChar(10)
  sortOrder     Int                    @default(0) @map("sort_order")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  module        CatalogCourseModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, sortOrder])
  @@map("catalog_module_media")
}

/// IDs Hotmart/Stone adicionais que resolvem para o mesmo produto (ex.: físico + digital).
model CatalogProductExternalId {
  id               String          @id @default(uuid())
  catalogProductId String          @map("catalog_product_id")
  provider         PaymentProvider
  externalId       String          @map("external_id") @db.VarChar(120)
  catalogProduct   CatalogProduct  @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([catalogProductId])
  @@map("catalog_product_external_ids")
}

/// Ao comprar o produto origem, também libera os produtos destino (admin).
model CatalogProductGrant {
  id               String         @id @default(uuid())
  sourceProductId  String         @map("source_product_id")
  grantedProductId String         @map("granted_product_id")
  sourceProduct    CatalogProduct @relation("GrantSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  grantedProduct   CatalogProduct @relation("GrantTarget", fields: [grantedProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, grantedProductId])
  @@index([sourceProductId])
  @@map("catalog_product_grants")
}

/// Acesso a um produto do catálogo comprado (Hotmart / Stone) — por e-mail.
model ProductEntitlement {
  id                    String         @id @default(uuid())
  email                 String         @db.VarChar(255)
  catalogProductId      String         @map("catalog_product_id")
  source                String         @default("hotmart") @db.VarChar(32)
  externalTransactionId String         @unique @map("external_transaction_id") @db.VarChar(120)
  createdAt             DateTime       @default(now()) @map("created_at")
  catalogProduct        CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)

  @@unique([email, catalogProductId])
  @@index([email])
  @@map("product_entitlements")
}

/// Registro cru de toda compra recebida por webhook, gravado ANTES de qualquer
/// tentativa de liberar acesso.
///
/// Existe porque hoje uma compra de produto sem mapeamento responde 200 com
/// `ignored: true`: a plataforma considera entregue, o cliente pagou e ninguem
/// fica sabendo. Com o registro, a venda vira uma linha visivel com status
/// `pending_mapping`, que o admin resolve cadastrando o ID e reprocessando.
///
/// `provider` e String, e nao o enum PaymentProvider, de proposito: esta tabela
/// recebe o que chegar — inclusive provedor novo ainda nao modelado — e nao pode
/// exigir migration para aceitar uma venda.
model PurchaseEvent {
  id String @id @default(uuid())

  /// hotmart | stone | stripe — minusculo, normalizado na escrita.
  provider              String  @db.VarChar(32)
  /// Nome do evento na origem (PURCHASE_APPROVED, charge.paid, ...).
  eventType             String? @map("event_type") @db.VarChar(120)
  externalTransactionId String  @map("external_transaction_id") @db.VarChar(120)
  /// ID do produto na plataforma. Null quando o payload nao traz.
  externalProductId     String? @map("external_product_id") @db.VarChar(120)
  /// Nome do produto na origem — e o que permite ao admin saber o que mapear.
  externalProductName   String? @map("external_product_name") @db.VarChar(255)

  email    String? @db.VarChar(255)
  nome     String? @db.VarChar(255)
  telefone String? @db.VarChar(40)
  cpf      String? @db.VarChar(20)
  currency String? @db.VarChar(10)
  country  String? @db.VarChar(10)

  /// received | processed | pending_mapping | ignored | failed
  status           String  @default("received") @db.VarChar(32)
  /// Preenchido quando o produto foi resolvido no catalogo.
  catalogProductId String? @map("catalog_product_id")
  /// Motivo do ignored/failed, para o admin ler sem abrir log.
  reason           String? @db.VarChar(255)

  /// Payload completo — permite reprocessar sem pedir reenvio a plataforma.
  payload Json

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  processedAt DateTime? @map("processed_at")

  /// Reentrega do mesmo webhook atualiza a linha em vez de duplicar a venda.
  @@unique([provider, externalTransactionId])
  @@index([status, createdAt])
  @@index([email])
  @@index([externalProductId])
  @@map("purchase_events")
}

/// Uma linha por tentativa de avisar o cliente que o acesso esta liberado.
///
/// Hoje a chamada ao n8n e fire-and-forget: se falha, sai um `warn` no log e
/// ninguem descobre — a recuperacao e um admin reenviando na mao. Com esta tabela
/// a entrega vira estado consultavel ("o acesso do fulano saiu?") e reprocessavel.
///
/// A propria tabela e a fila: `status = 'pending'` e trabalho a fazer. Nao usamos
/// BullMQ aqui porque o REDIS_URL e opcional neste deploy e porque a linha precisa
/// existir de qualquer forma para o admin — duas filas seriam duas verdades.
model AccessDelivery {
  id String @id @default(uuid())

  userId          String? @map("user_id")
  email           String  @db.VarChar(255)
  /// Venda que originou o aviso. Null em reenvio pedido pelo suporte.
  purchaseEventId String? @map("purchase_event_id")

  /// Identidade da venda. E o que torna o aviso idempotente: a plataforma manda
  /// mais de um webhook para a mesma compra, e so o primeiro vira mensagem.
  /// Null no reenvio do atendimento, que pode repetir a vontade.
  provider              String? @db.VarChar(32)
  externalTransactionId String? @map("external_transaction_id") @db.VarChar(120)

  /// new_account = primeiro acesso, leva link magico.
  /// products_added = ja tinha conta, leva so o que foi liberado (sem credencial).
  kind String @db.VarChar(32)

  /// pending | sent | failed
  status    String  @default("pending") @db.VarChar(32)
  attempts  Int     @default(0)
  lastError String? @map("last_error") @db.VarChar(500)

  /// Corpo enviado ao n8n, ja montado. Guardado para reenviar sem recalcular.
  payload Json

  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  /// Um aviso por venda. NULL nao conflita com NULL no Postgres, entao reenvio
  /// sem transacao fica de fora da trava.
  @@unique([provider, externalTransactionId])
  @@index([status, createdAt])
  @@index([email])
  @@index([purchaseEventId])
  @@map("access_deliveries")
}

/// Livro impresso a despachar.
///
/// A linha nasce na compra, e nao quando o codigo de rastreio aparece. Se ela so
/// existisse depois que a grafica preenchesse a planilha, o livro que a grafica
/// nunca postou seria invisivel: ninguem teria como saber que ele existe. E o
/// mesmo buraco do `pending_mapping` — o silencio e o que machuca.
///
/// Quem consulta a transportadora e o n8n; aqui e so o estado e o historico, para
/// o admin e para o comprador enxergarem a mesma coisa.
model BookShipment {
  id String @id @default(uuid())

  /// Venda que originou o despacho. Null so em linha criada na mao pelo suporte.
  purchaseEventId String? @map("purchase_event_id")
  userId          String? @map("user_id")
  email           String  @db.VarChar(255)
  nome            String? @db.VarChar(255)
  telefone        String? @db.VarChar(40)

  provider              String  @db.VarChar(32)
  externalTransactionId String  @map("external_transaction_id") @db.VarChar(120)
  externalProductId     String? @map("external_product_id") @db.VarChar(120)

  /// aguardando_postagem | postado | em_transito | entregue | devolvido | problema
  status String @default("aguardando_postagem") @db.VarChar(32)

  trackingCode String? @map("tracking_code") @db.VarChar(60)
  /// Deduzida do formato do codigo — a grafica posta por mais de um canal.
  carrier      String? @db.VarChar(32)
  /// Null quando a transportadora nao tem pagina publica de rastreio.
  trackingUrl  String? @map("tracking_url") @db.VarChar(500)

  /// Ultima descricao vinda da transportadora, em texto que o cliente entenda.
  lastStatusLabel String?   @map("last_status_label") @db.VarChar(255)
  /// Historico cru do rastreio, como o n8n mandou.
  events          Json?
  postedAt        DateTime? @map("posted_at")
  deliveredAt     DateTime? @map("delivered_at")
  /// Quando o proprio comprador confirmou que recebeu. Separada de `deliveredAt`
  /// porque as duas dizem "chegou" por bocas diferentes — e a transportadora
  /// dizer que entregou sem ninguem confirmar e exatamente o caso a investigar.
  deliveryConfirmedAt DateTime? @map("delivery_confirmed_at")
  lastCheckedAt   DateTime? @map("last_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Reentrega do mesmo webhook nao cria um segundo despacho.
  @@unique([provider, externalTransactionId])
  @@index([status, createdAt])
  @@index([email])
  @@index([trackingCode])
  @@map("book_shipments")
}

/// Permissões da biblioteca (Hotmart via n8n) — independente de assinatura premium.
model LibraryPermission {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  nome         String?  @db.VarChar(255)
  audioterapia Boolean  @default(false)
  pdf          Boolean  @default(false)
  livroDigital Boolean  @default(false) @map("livro_digital")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("library_permissions")
}

/// Trilha de auditoria — downloads de PDF com marca d'água.
model PdfDownload {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String?  @map("product_id") @db.VarChar(36)
  fileLabel String   @map("file_label") @db.VarChar(255)
  clientIp  String?  @map("client_ip") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("pdf_downloads")
}

/// Token de uso único para entrega do PDF personalizado (URL assinada, ~15 min).
model PdfDownloadToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  productId String    @map("product_id") @db.VarChar(36)
  jti       String    @unique @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("pdf_download_tokens")
}

enum PdfDownloadJobStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
}

/// Preparacao assincrona de copias licenciadas para entrega direta pelo R2.
model PdfDownloadJob {
  id               String               @id @default(uuid())
  userId           String               @map("user_id")
  productId        String               @map("product_id") @db.VarChar(36)
  status           PdfDownloadJobStatus @default(PENDING)
  dedupeKey        String               @unique @map("dedupe_key") @db.VarChar(160)
  watermarkVersion String               @default("v1") @map("watermark_version") @db.VarChar(16)
  locale           String               @default("pt-BR") @db.VarChar(8)
  sourceMediaFile  String               @map("source_media_file") @db.Text
  sourcePermission String               @map("source_permission") @db.VarChar(32)
  fileLabel        String               @map("file_label") @db.VarChar(255)
  r2Key            String?              @map("r2_key") @db.Text
  fileName         String?              @map("file_name") @db.VarChar(160)
  sizeBytes        Int?                 @map("size_bytes")
  errorCode        String?              @map("error_code") @db.VarChar(80)
  attempts         Int                  @default(0)
  countedAt        DateTime?            @map("counted_at")
  startedAt        DateTime?            @map("started_at")
  completedAt      DateTime?            @map("completed_at")
  expiresAt        DateTime             @map("expires_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, productId, status])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("pdf_download_jobs")
}

/// Perfil consolidado do fluxo de descoberta (onboarding por voz) — 1:1 com User.
/// usageContext: 'personal' | 'professional' — preferredStyle: 'direct' | 'supportive' | 'balanced'
/// (validado via CHECK constraint no banco e via zod na aplicacao; tabela compartilhada com o
/// projeto indevmediz, por isso usa TEXT em vez de enum nativo do Postgres).
model UserProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  discoveryCompleted Boolean   @default(false) @map("discovery_completed")
  consentedAt        DateTime? @map("consented_at")
  usageContext       String?   @map("usage_context")
  preferredStyle     String?   @map("preferred_style")
  core               Json?
  dynamics           Json?
  predictive         Json?
  compactProfile     String?   @map("compact_profile")
  profileVersion     Int       @default(1) @map("profile_version")
  /// ID Vida (Story 4.2): resumo compacto de marcos/fios abertos, injetado junto com compactProfile.
  lifeCompact        String?   @map("life_compact")
  lastConversationAt DateTime? @map("last_conversation_at")
  lastTopic          String?   @map("last_topic")
  /// Tutorial do meDIZ 2.0: nulo == ainda cai no gate; preenchido ao concluir ou pular.
  tutorialSeenAt     DateTime? @map("tutorial_seen_at")
  /// Ultima vez que a pessoa disse "agora nao" para a descoberta.
  ///
  /// Existe porque `discoveryCompleted` sozinho so tinha dois estados — fez ou nao
  /// fez — e a unica saida do fluxo era recusar o consentimento, que marcava
  /// "completou" para sempre. Quem aceitava e nao conseguia concluir ficava preso.
  discoveryDismissedAt DateTime? @map("discovery_dismissed_at")
  /// Quantas vezes adiou. Na terceira aparicao o convite deixa de ser opcional.
  discoveryDismissCount Int      @default(0) @map("discovery_dismiss_count")
  /// Primeira vez que a pessoa entrou no app depois da compra.
  ///
  /// O convite da descoberta so comeca a aparecer a partir da SEGUNDA visita: quem
  /// acabou de comprar um livro tem o direito de ler o livro antes de ser convidado
  /// a qualquer outra coisa.
  firstAccessAt         DateTime? @map("first_access_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discoveryCompleted])
  @@map("user_profiles")
}

/// Prompt ativo do agente de descoberta, editavel via painel de teste (`DISCOVERY_TEST_MODE=true`) em HML.
/// Linha unica (id fixo "singleton"); ausencia de registro == usa o DISCOVERY_SYSTEM_PROMPT hardcoded como padrao.
model DiscoveryConfig {
  id           String   @id @default("singleton")
  systemPrompt String   @map("system_prompt")
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("discovery_config")
}

/// Prompt customizado por agente conversacional (concierge/body/home/pet/simulador/professor), editavel
/// via painel de teste no /chat (`AGENT_PROMPT_TEST_MODE=true`). Uma linha por agente; ausencia de
/// registro == o workflow n8n usa o prompt hardcoded nele mesmo (este app so persiste, quem consome e o n8n).
model AgentPromptConfig {
  agent        String   @id
  systemPrompt String   @map("system_prompt")
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("agent_prompt_config")
}

/// Outbox de eventos da descoberta — consumido de forma assincrona pelo worker n8n de extracao de perfil.
/// status: 'pending' | 'processing' | 'processed' | 'failed' (CHECK constraint no banco, TEXT pelo mesmo motivo do UserProfile).
model DiscoveryEvent {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  eventType     String    @default("discovery.completed.v1") @map("event_type")
  schemaVersion Int       @default(1) @map("schema_version")
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  availableAt   DateTime  @default(now()) @map("available_at")
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([availableAt, status])
  @@map("discovery_events")
}

/// Outbox de checkpoints de conversa — compartilhado entre o ID Vida (fatos) e,
/// futuramente, a atualizacao continua do ID Pessoa. Gatilhos: contagem de mensagens
/// ou nova sessao com conteudo ainda nao extraido (ver ChatSession.messageCount).
/// status/trigger: TEXT com CHECK constraint, mesmo motivo do DiscoveryEvent.
model ConversationEvent {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  sessionId     String      @map("session_id")
  eventType     String      @default("conversation.checkpoint.v1") @map("event_type")
  schemaVersion Int         @default(1) @map("schema_version")
  trigger       String
  payload       Json
  status        String      @default("pending")
  attempts      Int         @default(0)
  lastError     String?     @map("last_error")
  availableAt   DateTime    @default(now()) @map("available_at")
  processedAt   DateTime?   @map("processed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([availableAt, status])
  @@map("conversation_events")
}

/// Outbox dos eventos de uso que viram variavel de conversa no Chatvolt.
///
/// O corredor de conversao reage ao que a pessoa FAZ, e nao ao calendario: uma
/// jornada guiada por data manda "aproveite seu ultimo dia" para quem nunca
/// entrou. Cada linha aqui e um fato de uso esperando virar variavel na conversa
/// do WhatsApp, e o n8n e quem resolve a conversa a partir do e-mail/telefone.
///
/// Uma linha por pessoa por evento: o unique e a propria regra de "so a primeira
/// vez". O unico recorrente e `pesquisa`, que reaproveita a mesma linha para
/// atualizar a data da ultima — sem isso, quem pesquisa dez vezes por dia geraria
/// dez escritas do mesmo valor.
model JourneyEvent {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  eventName   String    @map("event_name") @db.VarChar(32)
  /// Contato no momento do evento, para o n8n achar a conversa sem consultar o app.
  email       String    @db.VarChar(255)
  whatsapp    String?   @db.VarChar(40)
  /// `[{ nome, valor }]` — um evento pode gravar mais de uma variavel.
  variables   Json
  status      String    @default("pending") @db.VarChar(16)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  availableAt DateTime  @default(now()) @map("available_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventName])
  @@index([availableAt, status])
  @@map("journey_events")
}

/// ID Vida (Story 4.2): fatos de vida extraidos das conversas — duas naturezas (marker/ongoing).
/// type: 'marker' (permanente, ex.: "nao conheceu o pai") | 'ongoing' (com ciclo de vida, ex.: "perdeu o emprego").
/// status: marker so usa 'active'; ongoing usa 'open'|'tracking'|'resolved'|'archived'.
/// approach/sensitivity controlam se o app pode puxar o fato por iniciativa propria (ver Prompt F do doc).
model UserFact {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String
  fact            String
  category        String?
  status          String    @default("open")
  approach        String    @default("ask")
  sensitivity     String    @default("normal")
  confidence      Float?
  relevance       Int       @default(5)
  evidence        String?
  createdAt       DateTime  @default(now()) @map("created_at")
  lastMentionedAt DateTime  @default(now()) @map("last_mentioned_at")
  resolvedAt      DateTime? @map("resolved_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status, lastMentionedAt])
  @@map("user_facts")
}

/// Esteira de e-mails pos-compra: uma linha por comprador inscrito na sequencia.
/// Criada em grantPurchaseAccess, logo apos o usuario/entitlements — ponto unico
/// onde Hotmart e Stone/Guru convergem.
/// anchorAt e o relogio de toda a sequencia (compra = criacao do usuario = inicio
/// do trial de 7 dias), entao os passos sao sempre anchorAt + delayMinutes do template.
/// status: 'active' | 'converted' (assinou, para nos passos de oferta) |
/// 'unsubscribed' | 'completed'.
model EmailSequenceEnrollment {
  id                    String              @id @default(uuid())
  userId                String              @map("user_id")
  email                 String
  name                  String?
  lang                  String              @default("pt-BR")
  source                String
  externalTransactionId String              @map("external_transaction_id")
  anchorAt              DateTime            @default(now()) @map("anchor_at")
  currentStep           Int                 @default(0) @map("current_step")
  status                String              @default("active")
  unsubscribeToken      String              @unique @map("unsubscribe_token")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sends                 EmailSequenceSend[]

  @@unique([userId, externalTransactionId])
  @@index([status, currentStep])
  @@index([email])
  @@map("email_sequence_enrollment")
}

/// Log de disparos da esteira. O unique (enrollment_id, step) e a garantia de
/// idempotencia: mesmo com o cron rodando concorrente ou reprocessando, ninguem
/// recebe o mesmo passo duas vezes.
/// status: 'sent' | 'failed' | 'skipped' (suprimido por conversao/descadastro).
model EmailSequenceSend {
  id           String                  @id @default(uuid())
  enrollmentId String                  @map("enrollment_id")
  step         Int
  lang         String
  status       String                  @default("sent")
  error        String?
  sentAt       DateTime                @default(now()) @map("sent_at")
  enrollment   EmailSequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, step])
  @@index([enrollmentId])
  @@map("email_sequence_send")
}

/// Conteudo dos e-mails da esteira, um por (step, lang). Fica no banco para que a
/// copy seja editada sem tocar no workflow do n8n, que usa um unico no de envio generico.
/// delayMinutes e o offset a partir do anchorAt do enrollment — adicionar ou
/// reordenar um e-mail e mexer em linha, nao em automacao.
model EmailTemplate {
  id           String   @id @default(uuid())
  step         Int
  lang         String
  delayMinutes Int      @map("delay_minutes")
  subject      String
  preheader    String?
  html         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([step, lang])
  @@index([active, step])
  @@map("email_template")
}

/// Uma linha por venda que ficou no meio do caminho: PIX gerado e nao pago,
/// boleto emitido e nao pago, cartao recusado.
///
/// A propria tabela e a fila, igual a `AccessDelivery`: `status = 'armado'` com
/// `disparar_em` vencido e trabalho a fazer. Nao usamos os nos `Wait` do n8n
/// porque um Wait em curso nao pode ser cancelado de fora — quem pagou voltaria
/// da espera mesmo assim, e caberia ao fluxo lembrar de conferir na saida. Com a
/// fila no banco, quem pagou simplesmente para de aparecer na consulta.
///
/// `disparar_em` e o campo que separa "pendente" de "abandonado". O evento de
/// pagamento pendente chega no instante em que o QR e gerado, e todo comprador
/// passa por esse estado — inclusive quem vai pagar em quarenta segundos. Por
/// isso a chegada do webhook so agenda, e nunca fala com o cliente.
///
/// Quem consome e o n8n (workflow "Recuperacao de Vendas [meDIZ]"). Aqui e so o
/// estado e o historico, para o admin enxergar por que fulano recebeu — ou nao
/// recebeu — a mensagem.
model SalesRecoveryLead {
  id String @id @default(uuid())

  /// pagarme | guru | hotmart — minusculo, mesmo vocabulario de PurchaseEvent.
  provider              String  @db.VarChar(32)
  externalTransactionId String  @map("external_transaction_id") @db.VarChar(120)
  /// Nome do evento na origem (charge.pending, waiting_payment, ...).
  eventType             String? @map("event_type") @db.VarChar(120)
  /// pix | boleto | cartao — decide o template e o tempo de carencia.
  metodo                String  @db.VarChar(16)

  email    String? @db.VarChar(255)
  /// Ja com DDI, montado como em src/lib/phone.ts.
  telefone String? @db.VarChar(24)
  nome     String? @db.VarChar(255)

  externalProductId String? @map("external_product_id") @db.VarChar(120)
  produtoNome       String? @map("produto_nome") @db.VarChar(255)
  /// Em centavos.
  valor             Int?
  /// A cobranca desta pessoa, nao o link generico da oferta.
  linkPagamento     String? @map("link_pagamento")

  /// armado     — na fila, esperando a carencia vencer
  /// disparado  — recebeu o toque; espera 24h pelo cupom
  /// expirado   — o PIX/boleto venceu: sem toque, mas o cupom continua valendo
  /// recuperado — pagou, por esta transacao ou por outra do mesmo e-mail/telefone
  /// encerrado  — cancelada, reembolso ou chargeback: sai sem toque e sem cupom
  /// descartado — outro produto da mesma compra ja recebeu a mensagem
  /// falhou     — a Meta/Chatvolt recusaram o envio com 4xx; o motivo diz qual
  status String  @default("armado") @db.VarChar(24)
  /// Por que saiu da fila, para o admin ler sem abrir log.
  motivo String? @db.VarChar(255)

  /// Conversa criada no Chatvolt no envio do template. So existe depois do toque.
  conversationId String? @map("conversation_id") @db.VarChar(120)
  toques         Int     @default(0)

  /// A carencia, gravada na chegada do evento. O worker so olha quem ja venceu.
  dispararEm DateTime  @map("disparar_em")
  /// Reserva do worker, com validade de 15 min. Impede duas rodadas do relogio
  /// de pegarem o mesmo lead e mandarem a mensagem duas vezes.
  claimEm    DateTime? @map("claim_em")

  ultimoToqueEm  DateTime? @map("ultimo_toque_em")
  /// Quando o cupom de desconto fica elegivel — 24h depois do primeiro toque.
  cupomEm        DateTime? @map("cupom_em")
  cupomEnviadoEm DateTime? @map("cupom_enviado_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Uma compra gera varios eventos (order.created, charge.created,
  /// charge.pending) e a plataforma reenvia quando nao recebe 200. Sem esta
  /// trava o mesmo PIX armaria tres vezes.
  @@unique([provider, externalTransactionId])
  @@index([status, dispararEm])
  @@index([status, cupomEm])
  @@index([telefone, ultimoToqueEm])
  @@index([email])
  @@map("sales_recovery_leads")
}

/// Uma onda de reativacao: o recorte congelado, a isca, e o ritmo.
///
/// A lista de destinatarios e materializada na criacao e nunca recalculada. Um
/// filtro salvo mudaria de publico sozinho entre o momento em que alguem aprovou
/// e o momento em que a mensagem sai — e aqui isso significa mandar WhatsApp para
/// gente que ninguem revisou. O que se guarda em `filtros` e o pedido original,
/// para auditoria: "de onde saiu esta lista", nao "refaz a lista".
///
/// Quem envia e o n8n, que reivindica lotes em /api/campanhas/claim e responde em
/// /api/campanhas/result. O app nao chama o Chatvolt: envio no meio de um request
/// morre com o request, e onda pela metade nao se retoma sozinha.
model ReactivationCampaign {
  id   String @id @default(uuid())
  nome String @db.VarChar(160)

  /// rascunho | ativa | pausada | concluida | cancelada
  ///
  /// Nasce em rascunho de proposito: materializar a lista e apertar o botao sao
  /// dois atos, e o segundo precisa de alguem olhando o numero do primeiro.
  status String @default("rascunho") @db.VarChar(16)

  /// A isca. Nome do template aprovado na Meta — nome que nao existe volta 500.
  templateName String  @map("template_name") @db.VarChar(120)
  templateLang String  @default("pt_BR") @map("template_lang") @db.VarChar(10)
  /// whatsapp_oficial hoje. E-mail e Z-API cabem aqui sem migration.
  canal        String  @default("whatsapp_oficial") @db.VarChar(24)
  /// Como preencher os {{1}}, {{2}} do template, em ordem.
  ///
  /// `[{ posicao: 1, fonte: 'primeiro_nome' }, { posicao: 2, fonte: 'literal', valor: 'O CORPO DIZ' }]`
  ///
  /// Mora aqui e nao no n8n porque template novo nao pode exigir editar fluxo:
  /// o claim ja devolve as variaveis resolvidas, e o n8n so repassa.
  variaveis Json?
  /// Botao de URL do template, ou null se o template nao tem botao.
  ///
  /// `{ tipo: 'url', fonte: 'token' }` — a Meta guarda a base fixa e concatena
  /// so o valor, entao o que vai e o token puro do destinatario.
  botao Json?
  /// Para onde a conversa anda no CRM depois do envio.
  crmScenarioId String? @map("crm_scenario_id") @db.VarChar(120)
  crmStepId     String? @map("crm_step_id") @db.VarChar(120)

  /// O recorte como foi pedido, para auditoria. Nunca reexecutado.
  filtros   Json
  corteDias Int  @map("corte_dias")

  /// Ritmo, que e regra da fila e nao disciplina do operador. O teto protege a
  /// reputacao do numero; a janela evita disparo as tres da manha.
  tetoDiario Int @default(700) @map("teto_diario")
  horaInicio Int @default(8) @map("hora_inicio")
  horaFim    Int @default(20) @map("hora_fim")

  totalDestinatarios Int    @default(0) @map("total_destinatarios")
  criadoPor          String @map("criado_por") @db.VarChar(255)

  iniciadaEm   DateTime? @map("iniciada_em")
  concluidaEm  DateTime? @map("concluida_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  destinatarios ReactivationRecipient[]

  @@index([status, criadoEm])
  @@map("reactivation_campaigns")
}

/// Uma linha por pessoa por campanha. E a Regra 5 do plano: sem isto nao existe
/// taxa de conversao por origem, e nao da para parar uma onda no meio.
model ReactivationRecipient {
  id         String @id @default(uuid())
  campaignId String @map("campaign_id")
  userId     String @map("user_id")

  /// Copiados no momento do recorte, de proposito: o e-mail pode mudar, o estado
  /// vai mudar (e a campanha existe justamente para muda-lo). O que interessa
  /// depois e para quem se falou, e nao quem a pessoa virou.
  email    String  @db.VarChar(255)
  nome     String? @db.VarChar(255)
  telefone String? @db.VarChar(24)
  idioma   String? @db.VarChar(10)
  estado   String  @db.VarChar(24)
  origens  String[]

  /// pendente | enviando | enviado | falhou | descartado
  ///
  /// `clicou` e `acessou` nao sao status: sao carimbos de tempo. Uma pessoa pode
  /// clicar sem acessar, e o estado do envio continua sendo `enviado`.
  status String  @default("pendente") @db.VarChar(16)
  motivo String? @db.VarChar(255)

  /// O que vai no link do WhatsApp. Curto, e nao e o token de acesso: assim o
  /// token real nao viaja na previa do link nem no historico do navegador.
  trackToken String @unique @map("track_token") @db.VarChar(32)

  /// Reserva do worker, para dois lotes nunca pegarem a mesma pessoa.
  claimEm    DateTime? @map("claim_em")
  enviadoEm  DateTime? @map("enviado_em")
  clicouEm   DateTime? @map("clicou_em")
  /// Preenchido pelo proprio /r/<token> quando o acesso acontece na sequencia do
  /// clique. Acesso sem clique e derivado na metrica, a partir do rastro de uso.
  acessouEm  DateTime? @map("acessou_em")

  conversationId String? @map("conversation_id") @db.VarChar(120)
  tentativas     Int     @default(0)
  ultimoErro     String? @map("ultimo_erro") @db.VarChar(500)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  campaign ReactivationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// A mesma pessoa nao entra duas vezes na mesma onda.
  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@index([status, claimEm])
  @@map("reactivation_recipients")
}
